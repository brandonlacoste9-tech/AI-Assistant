# Netlify production env — paste in UI or: netlify env:import netlify.env
# Site: https://justbookme.ca

# REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://ulbfaxhsbbckotcbmslk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://justbookme.ca
NEXT_PUBLIC_CONTACT_EMAIL=info@justbookme.ca

# TWILIO SMS (all 3 required to send from production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRON (required for scheduled reminders + usage rollup on Netlify)
CRON_SECRET=

# Usage enforcement — ON unless set to false. Trial/starter/pro caps in plan-limits.ts.
# Pauses outbound SMS and new voice minutes at 200% of the plan cap.
# USAGE_ENFORCE=true

# Stripe — Starter $49 and Pro $149. Pro uses the WHITE_GLOVE env names (the IDs checkout reads).
# Do not set STRIPE_PRICE_PRO_* or STRIPE_PRICE_PREMIUM_* — nothing reads them.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_WHITE_GLOVE_MONTHLY=
# STRIPE_PRICE_WHITE_GLOVE_ANNUAL=

# Sales call webhook (POST /api/webhooks/outbound-sales). No hardcoded fallback.
# OUTBOUND_WEBHOOK_SECRET=
# VAPI_PRIVATE_KEY=
# VAPI_PHONE_NUMBER_ID=

# OPTIONAL — Stripe, Vapi, etc. (see docs/NETLIFY_DEPLOY.md)
# NEXT_PUBLIC_CALENDLY_URL=
# TWILIO_MESSAGING_SERVICE_SID=

# SENTRY (error monitoring — free tier)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=justbookme
# SENTRY_AUTH_TOKEN=sntrys_...

# DO NOT ADD: DATABASE_URL, OLLAMA_*, OAuth OQ client id/secret, TWILIO_API_KEY_*