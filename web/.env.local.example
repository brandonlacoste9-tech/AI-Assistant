# ── Supabase (required) ─────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Direct Postgres (optional — SQL clients, migrations CLI) ──
# Supabase Dashboard → Settings → Database → Connection string (URI)
# Do NOT expose on Netlify — the Next.js app uses the keys above.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── App URL ─────────────────────────────────────────────────────
# Local: http://localhost:3000
# Netlify: https://your-site.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Demo booking (optional — mailto fallback if unset) ──────────
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link/15min

# ── Stripe (Phase 1 — optional for Phase 0) ─────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Ollama / Gemma4 (local dev — intent LLM fallback) ───────────
# Netlify: leave OLLAMA_BASE_URL unset (regex-only in production).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4

# ── Twilio (Phase 2 — optional) ─────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=